# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA suba o arquivo ".env" (com valores reais) para o GitHub.

# String de conexão do MongoDB (MongoDB Atlas ou seu próprio servidor MongoDB)
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/ms_advocacia

# Chave secreta usada para assinar os tokens de login (JWT).
# Gere uma bem longa e aleatória, por exemplo com: openssl rand -hex 32
JWT_SECRET=troque_isto_por_uma_chave_bem_longa_e_aleatoria

# Porta em que o servidor vai rodar (o Render define isso automaticamente em produção)
PORT=3000

# Senha inicial do usuário master, usada apenas na primeira vez que o banco é criado (seed)
MASTER_SENHA_INICIAL=master123

# Endereço(s) permitido(s) a acessar a API (seu domínio no Render, e/ou http://localhost:3000 para testes)
CORS_ORIGIN=*

# Chave pública do Datajud (CNJ) — busca de movimentações processuais.
# Peça a sua em: https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_PUBLIC_KEY=

# Chave da API do Google Gemini (gratuita) — usada para explicar movimentações
# processuais em linguagem simples. Gere a sua em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
